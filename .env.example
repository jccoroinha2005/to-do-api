# Copie este arquivo para .env e troque a senha:  cp .env.example .env
# A senha pode ser qualquer uma, mas precisa ser a mesma nas duas linhas.

# Usada pelo docker compose (cria o banco com esta senha)
DB_PASSWORD=change_me

# Usada so se voce rodar a API fora do Docker (com o comando "go run ." no terminal)
DATABASE_URL=postgres://to_do_api_user:change_me@localhost:5432/to_do_api_db
